<Project Sdk="Microsoft.NET.Sdk">

  <!--
    JL_SPP DMX protocol ("USB-RDM-DMX" Bluetooth interfaces, RY-AI app) + fixture helpers.
    netstandard2.0: usable from .NET 6/8/10, .NET Framework 4.6.1+, MAUI (Android), Unity.
  -->
  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <RootNamespace>JlSpp.Dmx</RootNamespace>
    <PackageId>JlSpp.Dmx</PackageId>
    <Version>0.2.0</Version>
    <Description>DMX protocol of the "USB-RDM-DMX" Bluetooth interfaces (Jieli JL_SPP, RY-AI app), with Mindi Mini Spider and Chauvet Intimidator Spot 260X helpers.</Description>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- No warning for each self-explanatory enum member without an XML comment. -->
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.IO.Ports" Version="10.0.13" />
  </ItemGroup>

</Project>
